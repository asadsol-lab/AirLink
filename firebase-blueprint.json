{
  "entities": {
    "Device": {
      "collection": "users/{userId}/devices",
      "schema": {
        "deviceId": "string",
        "deviceName": "string",
        "platform": "string",
        "lastSeen": "timestamp",
        "online": "boolean",
        "socketId": "string"
      },
      "rules": "allow read, write: if request.auth != null && request.auth.uid == userId;"
    },
    "SignalingSession": {
      "collection": "users/{userId}/sessions",
      "schema": {
        "sessionId": "string",
        "callerId": "string",
        "targetId": "string",
        "mode": "string",
        "sdpOffer": "string",
        "sdpAnswer": "string",
        "status": "string",
        "createdAt": "timestamp"
      },
      "rules": "allow read, write: if request.auth != null && request.auth.uid == userId;"
    }
  }
}
